{
  "name": "crypo-mining-fleet-card",
  "version": "0.1.0",
  "description": "Home Assistant custom card for monitoring a crypto miner fleet",
  "main": "dist/crypo-mining-fleet-card.js",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "npm run clean && webpack --mode production && node scripts/gzip-dist.js",
    "verify:dist": "git diff --exit-code -- dist/",
    "build:checklist": "npm run build && npm run verify:dist",
    "clean": "rimraf dist",
    "lint": "eslint src/**/*.ts",
    "analyze": "webpack-bundle-analyzer dist/crypo-mining-fleet-card.js"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "crypto-mining"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "babel-loader": "^9.1.0",
    "eslint": "^8.0.0",
    "lit": "^3.0.0",
    "rimraf": "^5.0.0",
    "terser-webpack-plugin": "^5.3.0",
    "ts-loader": "^9.4.0",
    "typescript": "5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "lit": "^3.0.0"
  }
}
